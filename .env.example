# ===== 运营端配置（复制为 .env）——不含任何外部服务密钥 =====
# 服务器 mcapi 网关（赛狐代理/企微代理/占坑/审计 全在服务器，密钥只在服务器）
MCAPI_BASE=http://<服务器IP>:8100
# 你的个人 API Key（管理员发放；身份凭证，可吊销）
MCAPI_KEY=
# 运营名（操作留痕）
OPERATOR_NAME=

# 本地业务库：不配 = 默认本地 SQLite（零安装）。管理员/老机器可配 MySQL DSN：
# DB_URL=mysql+pymysql://user:pass@127.0.0.1:3306/fba_docs?charset=utf8mb4

# ===== 以下仅服务器/管理员实例需要（运营端留空）=====
# SELLFOX_CLIENT_ID=
# SELLFOX_CLIENT_SECRET=
# QIWE_TOKEN=
# QIWE_GUID=
